[Unit]
Description=Household Task Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=household-agent
Group=household-agent
WorkingDirectory=/opt/household-agent
ExecStart=/opt/household-agent/.venv/bin/python /opt/household-agent/main.py
UMask=0077
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/household-agent/storage
ProtectHome=true

[Install]
WantedBy=multi-user.target
